comment1.target=TrainerList()
comment1.text=\r\n\ Creates\ an\ empty\ trainer\ list.\r\n
comment2.params=pName
comment2.target=Trainer\ getTrainer(java.lang.String)
comment2.text=\r\n\ Returns\ the\ trainer\ associated\ with\ the\ given\ name,\ or\ {@code\ null}.\r\n\r\n\ @param\ pName\ the\ lookup\ key\r\n\ @return\ the\ matching\ {@link\ Trainer},\ or\ {@code\ null}\r\n
comment3.params=pName\ pTrainer
comment3.target=void\ addTrainer(java.lang.String,\ Trainer)
comment3.text=\r\n\ Adds\ or\ replaces\ a\ trainer\ under\ the\ given\ key.\r\n\r\n\ @param\ pName\ short\ identifier\ used\ for\ later\ retrieval\r\n\ @param\ pTrainer\ the\ {@link\ Trainer}\ to\ store\r\n
comment4.params=pName
comment4.target=void\ removeTrainer(java.lang.String)
comment4.text=\r\n\ Removes\ the\ trainer\ associated\ with\ the\ given\ key.\r\n\r\n\ @param\ pName\ the\ lookup\ key\r\n
